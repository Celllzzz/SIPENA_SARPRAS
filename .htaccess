<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Blokir akses langsung ke berkas dan folder sistem sensitif
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|artisan) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L,NC]

    # Khusus berkas upload bukti laporan jika diletakkan di root
    RewriteCond %{REQUEST_URI} ^/buktilaporan/
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Teruskan seluruh request ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Blokir akses ke berkas tersembunyi
<FilesMatch "^\.(env|git)">
    Order allow,deny
    Deny from all
</FilesMatch>
